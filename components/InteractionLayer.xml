<?xml version="1.0" encoding="utf-8" ?>
<component name="InteractionLayer" extends="Group">
    <interface>
        <!-- targets block from the page manifest: items, sprites, authToken -->
        <field id="targets" type="assocarray" />
        <!-- areas where a pointer gesture is live (calendar swipe surfaces) -->
        <field id="regions" type="array" />
        <field id="pageIndex" type="integer" value="0" />
        <field id="assetBase" type="string" />
        <field id="serviceBase" type="string" />
        <field id="identity" type="string" value="" />
        <!-- bumped by the scene when a swipe's manifest actually applies,
             so the one-swipe-at-a-time lock releases the moment the new
             image is up instead of waiting out the fallback cooldown -->
        <field id="swipeApplied" type="integer" value="0" />
        <!-- set by MainScene when a remote key arrives -->
        <field id="keyPress" type="string" />
        <field id="keyRelease" type="string" />
        <!-- which remote gestures the user enabled, from display.json -->
        <field id="gestures" type="assocarray" />
        <!-- "next"/"prev" when a page turn is asked for; MainScene clears it -->
        <field id="pageTurn" type="string" />
        <!-- centre of the widget a gesture acted on, so the spinner can
             sit on the thing that is actually changing -->
        <field id="busyAt" type="array" />
        <!-- a check-off worth celebrating: { kind: "burst"|"finale", x, y }
             (burst at the ticked box; finale when its whole list is done) -->
        <field id="celebrate" type="assocarray" />
    </interface>
    <children>
        <Group id="boxes" />
        <!-- holds the ticked sprite in the texture cache so the first press
             swaps instantly instead of waiting on a fetch -->
        <Poster id="preload" width="4" height="4" opacity="0.01" />
        <!-- Outline drawn round whatever the pointer is over. Four thin
             rectangles rather than one border: SceneGraph rectangles have
             no border property. Sits BELOW the pointer so the dot stays
             on top of it. -->
        <Group id="highlight" visible="false">
            <Rectangle id="hlTop" color="0x86E39AFF" />
            <Rectangle id="hlBottom" color="0x86E39AFF" />
            <Rectangle id="hlLeft" color="0x86E39AFF" />
            <Rectangle id="hlRight" color="0x86E39AFF" />
        </Group>
        <!-- same dot the other platforms draw: 20px red, 2px white ring -->
        <Poster id="pointer" uri="pkg:/images/pointer.png" width="24" height="24" visible="false" />
        <Timer id="hideTimer" repeat="false" duration="15" />
        <!-- hold-to-glide: a pause before the pointer starts running, then
             ~250px a second, close to a browser's key repeat -->
        <Timer id="holdDelay" repeat="false" duration="0.35" />
        <Timer id="holdRepeat" repeat="true" duration="0.04" />
        <!-- Double-click window for the navigation gestures, measured
             from the first key's RELEASE to the second key's PRESS.
             The portal's remote (remotePointer.js) uses 250ms measured
             RELEASE to RELEASE, so its budget also has to cover however
             long the second press is held; ours does not, and a thumb on
             a TV remote is slower than a keyboard. 550ms here is about
             where desktop OSes put their double-click default, plus room
             for the press itself. The cost is that tapping an arrow
             faster than twice a second to walk the pointer along can
             register as a gesture - holding the key is the intended way
             to move, and a press that glided the pointer more than
             GLIDE_CLICK_STEPS is excluded from counting as a click. -->
        <Timer id="dblTimer" repeat="false" duration="0.55" />
        <!-- a swipe takes a few seconds to come back; a second one sent
             underneath it just makes the backend resend the same dates -->
        <Timer id="swipeCooldown" repeat="false" duration="8" />
    </children>
    <script type="text/brightscript" uri="pkg:/components/InteractionLayer.brs" />
</component>
