<?xml version="1.0" encoding="utf-8" ?>
<component name="InteractionLayer" extends="Group">
    <interface>
        <!-- targets block from the page manifest: items, sprites, authToken -->
        <field id="targets" type="assocarray" />
        <field id="pageIndex" type="integer" value="0" />
        <field id="assetBase" type="string" />
        <field id="serviceBase" type="string" />
        <!-- set by MainScene when a remote key arrives -->
        <field id="keyPress" type="string" />
        <field id="keyRelease" type="string" />
    </interface>
    <children>
        <Group id="boxes" />
        <!-- holds the ticked sprite in the texture cache so the first press
             swaps instantly instead of waiting on a fetch -->
        <Poster id="preload" width="4" height="4" opacity="0.01" />
        <!-- same dot the other platforms draw: 20px red, 2px white ring -->
        <Poster id="pointer" uri="pkg:/images/pointer.png" width="24" height="24" visible="false" />
        <Timer id="hideTimer" repeat="false" duration="15" />
        <!-- hold-to-glide: a pause before the pointer starts running, then
             ~250px a second, close to a browser's key repeat -->
        <Timer id="holdDelay" repeat="false" duration="0.35" />
        <Timer id="holdRepeat" repeat="true" duration="0.04" />
    </children>
    <script type="text/brightscript" uri="pkg:/components/InteractionLayer.brs" />
</component>
