<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <children>
        <Rectangle id="bg" color="0x000000FF" width="1920" height="1080" />

        <!-- Mirrors the Tizen pairing screen: logo, heading, code, setup line -->
        <LayoutGroup id="pairingGroup" translation="[960, 250]" layoutDirection="vert" horizAlignment="center" itemSpacings="[70, 45, 110]">
            <Poster id="logo" uri="pkg:/images/logo.png" width="560" height="136" />
            <Label id="headingLabel" text="Display Device Code" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
            <Label id="codeLabel" text="" font="font:LargeSystemFont" color="0xFFFFFFFF" />
            <Label id="instructionsLabel" text="" font="font:MediumSystemFont" color="0xCCCCCCFF" />
        </LayoutGroup>

        <!-- A/B buffered page slots: each slot = page image + that page's
             native overlays, so transitions animate them as one unit (the
             clock fades/slides with its page). The hidden slot loads the
             next page, then the pair swaps - instantly for refreshes,
             animated for page transitions. Slots re-order so the incoming
             one draws on top. -->
        <Group id="pageHost">
            <!-- under = native layers behind the page (rotating page
                 backgrounds); the page image is a transparent PNG then -->
            <Group id="slotA" visible="false">
                <Group id="underA" />
                <Poster id="imageA" width="1920" height="1080" loadWidth="1920" loadHeight="1080" loadDisplayMode="scaleToFit" />
                <Group id="overlaysA" />
            </Group>
            <Group id="slotB" visible="false">
                <Group id="underB" />
                <Poster id="imageB" width="1920" height="1080" loadWidth="1920" loadHeight="1080" loadDisplayMode="scaleToFit" />
                <Group id="overlaysB" />
            </Group>
        </Group>
        <!-- display-wide visual overlays (balloons, snow, ...) live ABOVE the
             page slots so they keep flying through page transitions -->
        <Group id="effectLayer" />
        <!-- remote pointer + natively drawn task checkboxes -->
        <InteractionLayer id="interaction" />
        <!-- "your change is being applied" spinner: centered so it can't be
             missed, only while a user edit is rendering (transient, so no
             burn-in). Rotation is animated in code - BusySpinner does NOT
             spin a Poster nested in XML (it renders as a static child). -->
        <Poster id="spinnerPoster" uri="pkg:/images/spinner.png" width="80" height="80" translation="[920,500]" scaleRotateCenter="[40,40]" visible="false" />
        <!-- forces the spinner off if a busy=false is ever missed -->
        <Timer id="spinnerWatchdog" duration="75" repeat="false" />
        <!-- fallback only: the VersionTask long-poll is the primary refresh
             signal; this timer just catches the case where it can't connect -->
        <Timer id="refreshTimer" duration="60" repeat="true" />
        <!-- page rotation; duration set per page from display.json -->
        <Timer id="pageTimer" repeat="false" duration="60" />
    </children>
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
</component>
