<?xml version="1.0" encoding="utf-8" ?>
<component name="PairingTask" extends="Task">
    <interface>
        <!-- no default on purpose: the scene must inject the environment's
             API (from env.brs); a forgotten assignment should fail loudly,
             not quietly pair against the wrong backend -->
        <field id="apiBase" type="string" value="" />
        <field id="code" type="string" />
        <field id="result" type="assocarray" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/PairingTask.brs" />
</component>
