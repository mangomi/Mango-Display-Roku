<?xml version="1.0" encoding="utf-8" ?>
<component name="VersionTask" extends="Task">
    <interface>
        <field id="waitUrl" type="string" />
        <field id="manifestUrl" type="string" />
        <!-- where the service says to fetch assets from; may change -->
        <field id="assetBase" type="string" />
        <field id="manifest" type="assocarray" />
        <field id="version" type="integer" value="0" />
        <!-- true while the render service is processing a user edit -->
        <field id="busy" type="boolean" value="false" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/VersionTask.brs" />
</component>
